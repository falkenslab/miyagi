{
  "name": "miyagi",
  "version": "0.11.0",
  "private": true,
  "description": "Agent that manages a Moodle course as a teacher, built on @falkenslab/agent-kit",
  "author": "Francisco Vargas Ruiz",
  "license": "MIT",
  "type": "module",
  "bin": {
    "miyagi": "./dist/cli.js"
  },
  "files": [
    "dist",
    "plugin",
    "prompts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc && npm run build:gui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepack": "npm run build",
    "build:gui": "npm --prefix gui install --no-audit --no-fund --silent && npm --prefix gui run build",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@falkenslab/agent-kit": "0.30.1",
    "@mozilla/readability": "^0.6.0",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.13",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "playwright-core": "^1.64.1",
    "turndown": "^7.2.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
